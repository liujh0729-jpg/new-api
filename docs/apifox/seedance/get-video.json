{
  "name": "查询视频任务（OpenAI协议）",
  "type": "http",
  "method": "get",
  "path": "/v1/videos/{task_id}",
  "status": "released",
  "operationId": "getSeedanceOpenAIVideo",
  "description": "实际路径是 `GET /v1/videos/{task_id}`。成功状态为 `completed`，视频地址在 `metadata.url`，时长在 `metadata.duration`（可选）。`usage` 与官方兼容查询相同，未返回时省略。",
  "tags": ["Seedance"],
  "auth": { "type": "bearer", "bearer": { "token": "" } },
  "parameters": {
    "path": [
      {
        "id": "task_id#0",
        "name": "task_id",
        "required": true,
        "type": "string",
        "description": "创建任务时返回的 id"
      }
    ]
  },
  "responses": [
    {
      "name": "成功",
      "code": 200,
      "contentType": "json",
      "description": "任务状态",
      "jsonSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "task_id": { "type": "string" },
          "object": { "type": "string", "example": "video" },
          "status": { "type": "string", "enum": ["queued", "in_progress", "completed", "failed"] },
          "model": { "type": "string" },
          "progress": { "type": "integer" },
          "created_at": { "type": "integer", "format": "int64" },
          "completed_at": { "type": "integer", "format": "int64" },
          "error": {
            "type": "object",
            "description": "失败时返回",
            "additionalProperties": false,
            "properties": {
              "message": { "type": "string" },
              "code": { "type": "string" }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" }
            }
          },
          "usage": { "type": "object", "additionalProperties": false, "properties": { "completion_tokens": { "type": "integer", "format": "int64" }, "total_tokens": { "type": "integer", "format": "int64" } } }
        }
      }
    },
    {
      "name": "请求错误",
      "code": 400,
      "contentType": "json",
      "description": "任务 ID 或请求参数无效",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "未认证",
      "code": 401,
      "contentType": "json",
      "description": "Token 缺失或无效",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "任务不存在",
      "code": 404,
      "contentType": "json",
      "description": "任务不存在或不属于当前用户",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "上游错误",
      "code": 502,
      "contentType": "json",
      "description": "查询上游任务失败",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "服务不可用",
      "code": 503,
      "contentType": "json",
      "description": "上游暂不可用",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    }
  ]
}
