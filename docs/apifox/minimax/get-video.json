{
  "name": "查询 MiniMax H3 任务",
  "type": "http",
  "method": "get",
  "path": "/v1/videos/{task_id}",
  "status": "released",
  "operationId": "getMinimaxH3Video",
  "description": "使用创建接口返回的 `id` 请求 `GET /v1/videos/{task_id}`。状态可能为 `queued`、`in_progress`、`completed` 或 `failed`。成功时视频地址在 `metadata.url`；失败时查看 `error.message` 和 `error.code`。",
  "tags": ["MiniMax H3"],
  "auth": { "type": "bearer", "bearer": { "token": "" } },
  "parameters": {
    "path": [
      {
        "id": "task_id#0",
        "name": "task_id",
        "required": true,
        "type": "string",
        "description": "创建任务时返回的 id"
      }
    ]
  },
  "responses": [
    {
      "name": "成功",
      "code": 200,
      "contentType": "json",
      "description": "任务状态",
      "jsonSchema": {
        "type": "object",
        "required": ["id", "object", "model", "status", "progress", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "task_id": { "type": "string", "description": "兼容字段，后续请使用 id" },
          "object": { "type": "string", "example": "video" },
          "status": { "type": "string", "enum": ["queued", "in_progress", "completed", "failed"] },
          "model": { "type": "string" },
          "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
          "created_at": { "type": "integer", "format": "int64", "description": "Unix 时间戳（秒）" },
          "completed_at": { "type": "integer", "format": "int64", "description": "完成时间，未完成时省略" },
          "expires_at": { "type": "integer", "format": "int64", "description": "结果过期时间，未提供时省略" },
          "seconds": { "type": "string", "description": "兼容 OpenAI Video 的时长字符串" },
          "size": { "type": "string", "description": "兼容 OpenAI Video 的画面尺寸" },
          "remixed_from_video_id": { "type": "string" },
          "error": {
            "type": "object",
            "description": "失败时返回",
            "required": ["message", "code"],
            "properties": {
              "message": { "type": "string" },
              "code": { "type": "string" },
              "param": { "type": "string" },
              "request_id": { "type": "string" },
              "provider": { "type": "string" },
              "category": { "type": "string" },
              "upstream_code": { "type": "string" },
              "retryable": { "type": "boolean" }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "url": { "type": "string", "format": "uri", "description": "completed 时的视频地址" },
              "duration": { "type": "number" },
              "output_format": { "type": "string" },
              "resolution": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "name": "请求错误",
      "code": 400,
      "contentType": "json",
      "description": "任务 ID 无效、任务不存在或不属于当前用户",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "未认证",
      "code": 401,
      "contentType": "json",
      "description": "Token 缺失或无效",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "上游错误",
      "code": 502,
      "contentType": "json",
      "description": "查询 AIPDD 上游任务失败",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "服务不可用",
      "code": 503,
      "contentType": "json",
      "description": "AIPDD 上游暂不可用",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    }
  ]
}
