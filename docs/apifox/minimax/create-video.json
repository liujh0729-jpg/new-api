{
  "name": "创建 MiniMax H3 视频",
  "type": "http",
  "method": "post",
  "path": "/v1/videos",
  "status": "released",
  "operationId": "createMinimaxH3Video",
  "description": "MiniMax H3 只公开模型 `ap-minimax-h3`，使用 `POST /v1/videos`。可传 `request_kind` 明确选择能力，不传时由素材和提示词自动判断。`model`、`duration_seconds` 和 `video_resolution` 必填；时长必须是正整数秒，`ratio` 默认 `16:9`。\n\n参考图必须使用 `image_urls` 数组，参考音频必须使用 `audio_urls` 数组；不要使用 `duration`、`resolution`、`images` 或单值 `audio`。参考图和多模态的 1080p 最多 10 秒，其他可用组合最多 15 秒。`seed` 只对多图参考和多图多音频能力生效。完整约束见「MiniMax H3 模型与约束」。\n\n创建后使用返回的 `id` 请求 `GET /v1/videos/{task_id}`。",
  "tags": ["MiniMax H3"],
  "auth": { "type": "bearer", "bearer": { "token": "" } },
  "requestBody": {
    "type": "application/json",
    "required": true,
    "jsonSchema": {
      "type": "object",
      "required": ["model", "duration_seconds", "video_resolution"],
      "description": "prompt 除图片音频同步视频能力外必填。不同能力的素材数量、分辨率、比例和时长约束见接口说明。",
      "properties": {
        "model": {
          "type": "string",
          "description": "MiniMax H3 唯一公开模型名",
          "enum": ["ap-minimax-h3"]
        },
        "request_kind": { "type": "string", "enum": ["text_to_video", "reference_to_video", "multimodal_to_video", "image_audio_lipsync", "first_last_frame_to_video"], "description": "可选；明确选择能力。不传时按素材和提示词自动判断" },
        "prompt": { "type": "string", "minLength": 1, "description": "文生视频、多图参考、多图多音频和首尾帧模型必填；图片音频同步视频模型不使用" },
        "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 15, "description": "必填，正整数秒。reference-to-video 和 multimodal-to-video 在 1080p 时最大为 10，其他可用组合最大为 15" },
        "video_resolution": { "type": "string", "enum": ["480p", "768p", "1080p"], "description": "必填。text-to-video 和 first-last-frame-to-video 不支持 1080p" },
        "ratio": { "type": "string", "enum": ["16:9", "9:16", "1:1"], "default": "16:9", "description": "可选，默认 16:9。multimodal-to-video、image-audio-lipsync 和 first-last-frame-to-video 不支持 1:1" },
        "image_urls": { "type": "array", "minItems": 1, "maxItems": 9, "items": { "type": "string", "format": "uri" }, "description": "可由上游访问的图片 URL。reference-to-video 和 multimodal-to-video 需 1–9 个；image-audio-lipsync 恰好 1 个" },
        "audio_urls": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "format": "uri" }, "description": "可由上游访问的音频 URL。multimodal-to-video 需 1–3 个；image-audio-lipsync 恰好 1 个" },
        "first_frame": { "type": "string", "format": "uri", "description": "仅 first-last-frame-to-video，与 last_frame 同时必填" },
        "last_frame": { "type": "string", "format": "uri", "description": "仅 first-last-frame-to-video，与 first_frame 同时必填" },
        "seed": { "type": "integer", "description": "仅 reference-to-video 和 multimodal-to-video 生效" }
      }
    },
    "data": "{\n  \"model\": \"ap-minimax-h3\",\n  \"request_kind\": \"text_to_video\",\n  \"prompt\": \"一只橘猫在木桌旁喝水\",\n  \"duration_seconds\": 5,\n  \"video_resolution\": \"480p\",\n  \"ratio\": \"16:9\"\n}"
  },
  "responses": [
    {
      "name": "成功",
      "code": 200,
      "contentType": "json",
      "description": "任务已创建",
      "jsonSchema": {
        "type": "object",
        "required": ["id", "object", "model", "status", "progress", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "task_id": { "type": "string", "description": "兼容字段，后续请使用 id" },
          "object": { "type": "string", "example": "video" },
          "status": { "type": "string", "enum": ["queued", "in_progress", "completed", "failed"] },
          "model": { "type": "string" },
          "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
          "created_at": { "type": "integer", "format": "int64", "description": "Unix 时间戳（秒）" },
          "completed_at": { "type": "integer", "format": "int64" },
          "expires_at": { "type": "integer", "format": "int64" },
          "seconds": { "type": "string" },
          "size": { "type": "string" },
          "remixed_from_video_id": { "type": "string" },
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "code": { "type": "string" },
              "param": { "type": "string" },
              "request_id": { "type": "string" },
              "provider": { "type": "string" },
              "category": { "type": "string" },
              "upstream_code": { "type": "string" },
              "retryable": { "type": "boolean" }
            }
          },
          "metadata": { "type": "object", "additionalProperties": true,
            "properties": {
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    {
      "name": "请求错误",
      "code": 400,
      "contentType": "json",
      "description": "字段、素材数量或分辨率/比例/时长组合不符合模型约束",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "未认证",
      "code": 401,
      "contentType": "json",
      "description": "Token 缺失或无效",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "上游错误",
      "code": 502,
      "contentType": "json",
      "description": "AIPDD 上游创建任务失败",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    },
    {
      "name": "服务不可用",
      "code": 503,
      "contentType": "json",
      "description": "AIPDD 模型或上游渠道暂不可用",
      "jsonSchema": { "type": "object", "additionalProperties": true }
    }
  ]
}
